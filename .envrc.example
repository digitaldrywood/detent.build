# Local development. Copy to .envrc and run `direnv allow`.
#
# There is no database and no secret here — the site is a stateless binary
# serving templ-rendered pages. Nothing in this file is sensitive.

export PORT=3000
export ENV=development
export SITE_NAME=detent.build
export SITE_URL=http://localhost:3000

# Production, set in the Dokploy application environment:
#
#   ENV=production
#   SITE_URL=https://detent.build
#
# SITE_URL must be the apex, https, and carry no trailing slash. detent.build
# has no www host, and .build is on the HSTS preload list, so a plain-http or
# www absolute URL is unreachable rather than merely untidy.
#
# Leave PORT at 3000: the Dokploy domain entry is bound to container port 3000.
