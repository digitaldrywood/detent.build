package partials

import (
	"detent.build/internal/content"
	"detent.build/ui/components"
	"strconv"
)

// InstallTabs renders the platform-tabbed install surface. Each tab is a real
// URL that HTMX swaps in place; with JavaScript off, the link is a normal
// navigation that renders the same page with that tab selected.
templ InstallTabs(current content.InstallTarget) {
	// These are navigation links, not a tabs widget. Each one is a real URL that
	// renders a full page on its own, and HTMX only shortcuts the round trip.
	// Claiming role="tab" without tabpanel wiring, roving tabindex, and arrow
	// keys promises a keyboard model that does not exist — a labeled nav with
	// aria-current is both simpler and actually true.
	<div id="install-tabs" class="overflow-hidden rounded-card border border-line bg-page">
		<nav aria-label="Install platform" class="flex overflow-x-auto border-b border-line font-mono text-xs">
			for _, t := range content.InstallTargets {
				<a
					href={ templ.SafeURL("/install/" + t.Key) }
					hx-get={ "/install/" + t.Key }
					hx-target="#install-tabs"
					hx-swap="outerHTML"
					hx-push-url="true"
					if t.Key == current.Key {
						aria-current="page"
					}
					class={ "whitespace-nowrap border-b-2 px-5 py-3 transition-colors",
						templ.KV("border-accent text-accent", t.Key == current.Key),
						templ.KV("border-transparent text-dim hover:text-sec", t.Key != current.Key) }
				>
					{ t.Label }
				</a>
			}
		</nav>
		@InstallPanel(current)
	</div>
}

// InstallPanel is the swappable body: one platform's commands.
templ InstallPanel(target content.InstallTarget) {
	<div id="install-panel" class="flex flex-col gap-4 p-6">
		@components.Command(components.CommandProps{
			ID:       "install-" + target.Key,
			Prompt:   sigilFor(target.Shell),
			Cmd:      target.Primary.Cmd,
			Caption:  target.Primary.Caption,
			Emphasis: true,
		})
		for i, cmd := range target.Others {
			@components.Command(components.CommandProps{
				ID:      "install-" + target.Key + "-alt-" + strconv.Itoa(i),
				Prompt:  sigilFor(target.Shell),
				Cmd:     cmd.Cmd,
				Caption: cmd.Caption,
			})
		}
		if target.Footnote != "" {
			<p class="pt-1 text-xs leading-relaxed text-dim">{ target.Footnote }</p>
		}
	</div>
}

func sigilFor(shell string) string {
	if shell == "powershell" {
		return "PS>"
	}
	return "$"
}

// InstallSection is the home page's closing block: the Cloud path first, the
// runner install it needs, and the self-hosted alternative.
templ InstallSection() {
	@components.Section("10", "Get started", "Start on Detent Cloud. Your runner does the work.",
		"Sign in, create a project, and enroll a machine. The Free plan needs no card.") {
		<div class="grid gap-4 lg:grid-cols-[1fr_380px]">
			@components.Card("p-6") {
				<ol class="flex flex-col gap-3 text-sm leading-relaxed text-sec">
					@getStartedStep(1, "Create an account at cloud.detent.build and create or join an organization.")
					@getStartedStep(2, "Create a project. New projects start with Todo, In Progress, Merging, Done, Blocked, and Human Review; change them to fit the work.")
					@getStartedStep(3, "Commit detent.yaml and WORKFLOW.md to the repository the project works in.")
					@getStartedStep(4, "Install Detent on the runner machine and sign in there to Codex or Claude Code.")
					@getStartedStep(5, "In Settings › Providers & runners, choose Enroll a runner and run the command it shows.")
					@getStartedStep(6, "File an issue in Todo and watch it move across the board.")
				</ol>
				<div class="mt-6 flex flex-wrap gap-3">
					<a
						href={ templ.SafeURL(content.CloudSignUpURL) }
						class="rounded-card border border-accent bg-accent px-5 py-2.5 text-sm font-semibold text-page transition-opacity hover:opacity-90"
					>
						Create a free account
					</a>
					<a
						href={ templ.SafeURL(content.Doc("cloud-onboarding.md")) }
						class="rounded-card border border-line px-5 py-2.5 text-sm text-sec transition-colors hover:border-accent hover:text-accent"
					>
						Cloud onboarding guide
					</a>
				</div>
			}
			@components.Card("flex flex-col p-6") {
				<h3 class="text-base font-semibold text-text">Rather run it yourself?</h3>
				<p class="mt-3 text-sm leading-relaxed text-sec">
					The Hub is the same binary. Self-hosting is free and needs no Detent Cloud account or
					billing. You need one host, SQLite, and a TLS proxy in front.
				</p>
				<a href="/install" class="mt-4 inline-flex min-h-6 items-center font-mono text-xs text-accent hover:underline">
					Self-host the Hub &#8594;
				</a>
			}
		</div>
		<div class="mt-4">
			@InstallTabs(content.InstallTargets[0])
		</div>
		<div class="mt-4">
			@components.Terminal("enroll the runner") {
				<span class="text-dim">{ "$ " }</span>{ "detent hub runner register --url https://cloud.detent.build/organizations/ORGANIZATION_ID \\\n" }
				{ "    --token TOKEN --name \"Build host\" --service\n" }
				<span class="text-dim">{ "  creates the runner's identity, writes its configuration, and installs a background service" }</span>
			}
		</div>
	}
}

templ getStartedStep(n int, text string) {
	<li class="grid grid-cols-[1.5rem_1fr] gap-2">
		<span class="font-mono text-xs leading-relaxed text-dim">{ strconv.Itoa(n) }</span>
		<span>{ text }</span>
	</li>
}
