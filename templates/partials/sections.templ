package partials

import (
	"detent.build/internal/content"
	"detent.build/internal/videos"
	"detent.build/ui/components"
)

// Inversion is the section that makes someone understand what they are looking
// at: the same task under an autonomy-first assistant and under Detent. It
// appears at a different position on each page that uses it, so the section
// number is a parameter rather than a constant.
// first is true when this is the section directly under a page masthead, which
// wants the tighter top padding.
templ Inversion(num string, first bool) {
	@inversionSection(num, first) {
		<div class="grid gap-4 lg:grid-cols-2">
			@components.Card("p-6") {
				<div class="font-mono text-xs text-dim">
					&#8220;add OAuth token rotation&#8221; &#8212; autonomy-first assistant
				</div>
				<ol class="mt-5 flex flex-col gap-2.5 text-sm leading-relaxed text-sec">
					<li>It starts as a prompt. The agent picks a plan.</li>
					<li>You read the plan and inspect partial edits.</li>
					<li>It misses the migration. You redirect.</li>
					<li>It skips the tests. You redirect again.</li>
					<li class="pt-1 text-err">You are the supervision loop.</li>
				</ol>
			}
			<div class="rounded-card border border-accent/40 bg-surface p-6">
				<div class="font-mono text-xs text-accent">
					&#8220;add OAuth token rotation&#8221; &#8212; Detent
				</div>
				<ol class="mt-5 flex flex-col gap-2.5 text-sm leading-relaxed text-sec">
					<li>It starts as an issue naming the storage change, CLI behavior, migration, rollback, and tests.</li>
					<li>A runner executes that contract in an isolated worktree.</li>
					<li>It produces a reviewable Change Request.</li>
					<li>It does not land until your gates clear.</li>
					<li class="pt-1 text-ok">Your process runs. You read one change.</li>
				</ol>
			</div>
		</div>
		<p class="mt-6 max-w-[760px] text-sm leading-relaxed text-dim">
			The goal is not to replace engineers or hide work behind opaque behavior. It is to scale the
			judgment of engineers who already have a high bar. The system does not try to be smarter than
			you; it tries to be as disciplined as you would be, every time, in parallel.
		</p>
	}
}

templ inversionSection(num string, first bool) {
	{{ heading := "A system, not an agent." }}
	{{ lede := "Autonomy-first tools put the intelligence in the agent and ask you to supervise it. Detent puts the intelligence in your spec and supplies the discipline. Same task, two interaction models." }}
	if first {
		@components.FirstSection(num, "The inversion", heading, lede) {
			{ children... }
		}
	} else {
		@components.Section(num, "The inversion", heading, lede) {
			{ children... }
		}
	}
}

// HowItWorksSummary is the home page's condensed mechanism: the lane rail plus
// the six numbered steps.
templ HowItWorksSummary() {
	@components.Section("05", "How it works", "Your lanes. Your gates between them.",
		"The Hub's board is the state machine. Runners on your machines move work through it, and your gates decide when it advances.") {
		@components.LaneRail()
		<div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
			for _, step := range content.Steps {
				@stepCard(step)
			}
		</div>
		<div class="mt-4">
			<a href="/how-it-works" class="font-mono text-xs text-accent hover:underline">
				The mechanism in full, with the gate model and worktree isolation &#8594;
			</a>
		</div>
	}
}

templ stepCard(step content.Step) {
	@components.Card("flex flex-col p-5") {
		<div class="font-mono text-xs text-accent">
			{ stepNum(step.Num) } &#8212; { step.Title }
		</div>
		<p class="mt-2.5 text-sm leading-relaxed text-sec">{ step.Body }</p>
	}
}

func stepNum(n int) string {
	return string(rune('0' + n))
}

// MergeTrainSection is its own section because serialized, gated landing is
// the row in the comparison matrix nobody else has.
templ MergeTrainSection(num string) {
	@components.Section(num, "Landing", "One change lands at a time.",
		"In Merging, the runner that holds the project lands the accepted change on the base branch with plain git, one change at a time. Parallel agents never race each other onto your main line.") {
		<div class="overflow-x-auto rounded-card border border-line bg-page p-6">
			<div class="flex min-w-max items-center gap-3 font-mono text-xs">
				for i, stage := range content.MergeTrain {
					if i > 0 {
						<span class="text-dim">&#8594;</span>
					}
					<span
						class={ "whitespace-nowrap rounded-chip border px-3 py-2",
							components.ToneBorder(stage.Tone), components.ToneText(stage.Tone),
							templ.KV("text-text", stage.Tone == "") }
					>
						{ stage.Label }
					</span>
				}
			</div>
		</div>
		<p class="mt-4 max-w-[760px] text-sm leading-relaxed text-dim">
			A change that cannot land goes to <span class="font-mono text-xs text-sec">Blocked</span> with its
			reason instead of landing broken. Native projects make no GitHub API calls by default; git clone
			and push work against any host.
			<a href={ templ.SafeURL(content.Doc("concepts.md")) } class="text-accent hover:underline">Board states &#8594;</a>
		</p>
	}
}

// OperatorSurface shows the real dashboard, large. It is the highest-value
// image the project has, and it is a screenshot of the running product.
templ OperatorSurface() {
	@components.Section("07", "The operator surface", "The board stays honest.",
		"Live counts, running agents, budget and capacity, reports, and activity. \"In progress\" means an agent is actually working right now.") {
		<figure class="overflow-hidden rounded-card border border-line bg-page">
			<img
				src="/static/images/dashboard-dark.png"
				alt="The Detent dashboard: a sidebar of nine projects, a live board with Backlog, Blocked, Human Review, and Review lanes, and a header row showing running, queued, waiting, blocked, and completed counts."
				width="2972"
				height="1745"
				class="block w-full"
				loading="lazy"
				decoding="async"
			/>
		</figure>
		<div class="mt-4 grid gap-4 lg:grid-cols-[1fr_320px]">
			@components.Card("p-5") {
				<p class="text-sm leading-relaxed text-sec">
					The same board is available over MCP, so your own agent can file issues, read run history,
					and review changes &#8212; and the CLI reads it too, from any runner.
				</p>
			}
			@components.Card("p-5") {
				<a href="/dashboard" class="inline-flex min-h-6 items-center font-mono text-xs text-accent hover:underline">
					Tour the operator surface &#8594;
				</a>
			}
		</div>
	}
}

// ContractsSection shows the two checked-in files, because developers believe
// config they can read.
templ ContractsSection() {
	@components.Section("08", "Contracts, shown", "Config you can read beats adjectives.",
		"Two files, committed to your repository: the machine contract and the agent contract. Both are excerpted here from Detent's own repository, which Detent builds on Detent Cloud.") {
		<div class="grid gap-4 lg:grid-cols-2">
			@components.CodeSurface("detent.yaml", "digitaldrywood/detent") {
				<span class="text-info">tracker</span>{ ":\n" }
				{ "    " }<span class="text-info">kind</span>{ ": hub_native\n" }
				{ "    " }<span class="text-info">repository</span>{ ": digitaldrywood/detent\n" }
				{ "    " }<span class="text-info">lanes</span>{ ":\n" }
				{ "        - " }<span class="text-info">name</span>{ ": Todo\n          " }<span class="text-info">role</span>{ ": active\n" }
				{ "        - " }<span class="text-info">name</span>{ ": Human Review\n          " }<span class="text-info">role</span>{ ": holding\n" }
				{ "        - " }<span class="text-info">name</span>{ ": Done\n          " }<span class="text-info">role</span>{ ": terminal\n" }
				<span class="text-info">review</span>{ ":\n" }
				{ "    " }<span class="text-info">human</span>{ ": false\n" }
				<span class="text-info">gate</span>{ ":\n" }
				{ "    " }<span class="text-info">kind</span>{ ": command\n" }
				{ "    " }<span class="text-info">run</span>{ ": \"make check-landing\"\n" }
				{ "    " }<span class="text-info">ci_failure_action</span>{ ": rework\n" }
				{ "    " }<span class="text-info">validator</span>{ ":\n" }
				{ "        " }<span class="text-info">enabled</span>{ ": true\n" }
				{ "    " }<span class="text-info">security_audit</span>{ ":\n" }
				{ "        " }<span class="text-info">enabled</span>{ ": true" }
			}
			@components.CodeSurface("WORKFLOW.md", "the agent contract, checked in and portable") {
				{ "You are working on " }<span class="text-text">**Detent**</span>{ ", the Go agent\norchestrator, on native Detent Cloud work item\n" }<span class="text-text">{ "{{ issue.identifier }}" }</span>{ ". The issue and its\ndecisions live on Detent Cloud.\n\n" }
				{ "Follow " }<span class="text-text">CLAUDE.md</span>{ " and " }<span class="text-text">AGENTS.md</span>{ "; they are the project\nauthority for layout, formatting, validation, and\nreview conventions." }
			}
		</div>
		<p class="mt-4 max-w-[760px] text-sm leading-relaxed text-dim">
			The lanes above are an excerpt; Detent&#39;s own board configures nine. Trusted workflow
			definitions from the repository&#39;s default branch apply automatically. You can keep reading
			by hand too; nobody will revoke your keyboard.
			<a href={ templ.SafeURL(content.DetentConfigURL) } class="text-accent hover:underline">The whole file &#8599;</a>
		</p>
	}
}

// ShipsItself is the credibility anchor, and it is literally true. The section
// number is a parameter because this block appears at a different position on
// the home page than it does on the open-source page.
templ ShipsItself(num string) {
	<section class="mx-auto max-w-[1280px] px-6 pt-24 md:px-8">
		<div class="rounded-card border border-line bg-gradient-to-b from-surface to-page p-8 md:p-10">
			<div class={ "grid gap-8", templ.KV("lg:grid-cols-[minmax(0,1fr)_minmax(320px,440px)] lg:items-center", hasFeaturedVideo()) }>
				<div class="max-w-[640px]">
					@components.Eyebrow(num, "Proof")
					<h2 class="mt-3 text-2xl font-bold text-text">It ships itself.</h2>
					<p class="mt-3 text-base leading-relaxed text-sec">
						Detent is built on Detent Cloud. Its issues live on the Hub, runners pick them up, and
						the agents they dispatch write the changes that land in
						<span class="font-mono text-sm text-text">digitaldrywood/detent</span>.
					</p>
					<p class="mt-3 text-sm leading-relaxed text-dim">
						Its <span class="font-mono text-xs">detent.yaml</span> and
						<span class="font-mono text-xs">WORKFLOW.md</span> are in the repository, readable as a
						starting point for your first project.
					</p>
					<a
						href={ templ.SafeURL(content.DetentConfigURL) }
						class="mt-6 inline-flex rounded-card border border-accent bg-accent px-5 py-3 font-mono text-xs font-semibold text-page transition-opacity hover:opacity-90"
					>
						Read Detent&#39;s detent.yaml &#8599;
					</a>
				</div>
				if featured, ok := videos.Published.Featured(); ok {
					@VideoCard(featured, true)
				}
			</div>
		</div>
	</section>
}

func hasFeaturedVideo() bool {
	_, ok := videos.Published.Featured()
	return ok
}

// RunnersSection is the fleet story: the Hub routes work, and the machines
// that touch code are yours.
templ RunnersSection() {
	@components.Section("10", "Runners", "Your machines do the work.",
		"A runner keeps your repository checkout, your agent sign-ins, and your toolchain. Nothing that touches your code runs on the Hub.") {
		<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
			@runnerCard("A laptop", "Enroll the machine you already work on and let it pick up issues while you review.")
			@runnerCard("A build server", "Put the runner where your toolchain, caches, and secrets already live.")
			@runnerCard("A VM", "Run as many as your plan's concurrent work allows, each routed to its own projects.")
			@runnerCard("A Fly Sprite", "Cloud runners on Fly Sprites, with Luna walking you through setup.")
		</div>
		<p class="mt-4 max-w-[760px] text-sm leading-relaxed text-dim">
			Enroll one from Settings &#8250; Providers &amp; runners. It runs
			<span class="font-mono text-xs text-sec">detent hub runner register</span> once and installs a
			background service. Cloud assigns each runner its allowed projects and model selection.
			<a href={ templ.SafeURL(content.Doc("sprite-runners.md")) } class="text-accent hover:underline">Runners on Fly Sprites &#8594;</a>
		</p>
	}
}

templ runnerCard(title string, body string) {
	@components.Card("p-5") {
		<h3 class="font-mono text-xs text-text">{ title }</h3>
		<p class="mt-2 text-sm leading-relaxed text-sec">{ body }</p>
	}
}
