package pages

import (
	"detent.build/internal/content"
	"detent.build/internal/meta"
	"detent.build/templates/layouts"
	"detent.build/templates/partials"
	"detent.build/ui/components"
)

templ WhyDetent() {
	@layouts.Base(whyDetentMeta()) {
		@partials.PageHeader(
			"Why Detent",
			"Run your own process across many agents at once.",
			"This page covers the argument, the two default choices that define Detent's footprint, and the comparison matrix, including the rows where Detent loses.",
		)
		@partials.Inversion("01", true)
		@components.Section("02", "Who this is for", "And who should close the tab.", "") {
			<div class="grid gap-4 lg:grid-cols-3">
				@audienceCard("The person who runs delivery",
					"An engineering lead, a producer, an operations owner. You already have review standards, approval rules, and an order things happen in. Your bottleneck is throughput on well-specified work without lowering the bar.",
					"You want the state machine, the gate model, serialized landing, and the isolation story. You will read a detent.yaml before you read a testimonial. There is no testimonial on this site.")
				@audienceCard("The solo builder with five projects",
					"One person, several repositories or pipelines, a queue of work that is clear but unwritten. You want parallelism without babysitting five chat sessions.",
					"Start on the Free plan with no card, enroll the laptop you already have, and bill agent work against the Codex or Claude Code subscription you already pay for.")
				@audienceCard("The platform team",
					"Evaluating agent work for an organization. Your questions are governance questions.",
					"Agents on machines you control, monthly budgets and capacity limits, runner routing per project, review decisions on the Hub, and a self-hosted Hub when the work cannot leave your network.")
			</div>
			<div class="mt-4 rounded-card border border-line bg-page p-6">
				<div class="font-mono text-xs text-dim">Not for</div>
				<p class="mt-3 max-w-[760px] text-sm leading-relaxed text-sec">
					People who want an autonomous assistant to talk to. People looking for a copilot inside an
					editor. People who want a vendor to run the agents on its own machines. Detent is none of
					those, and it is better for everyone if that is clear here rather than three pages into the
					docs.
				</p>
			</div>
		}
		@components.Section("03", "The defaults", "Two choices define the footprint. Both are deliberate.", "") {
			<div class="grid gap-4 lg:grid-cols-2">
				@components.Card("p-6") {
					<h3 class="text-base font-semibold text-text">The Hub coordinates. Your machines do the work.</h3>
					<p class="mt-3 text-sm leading-relaxed text-sec">
						The Hub holds the board, the issues, the conversation history, the review decisions, and
						the policy each project runs under. Runners are machines you enroll, and they keep your
						checkout, your agent sign-ins, and your toolchain.
					</p>
					<p class="mt-3 text-sm leading-relaxed text-sec">
						Nothing that touches your code runs on the Hub. That is why Detent Cloud can be the
						default without holding your checkout or your credentials, and why the same Hub can run
						on your own host when it must.
					</p>
				}
				@components.Card("p-6") {
					<h3 class="text-base font-semibold text-text">Your subscriptions pay for the model.</h3>
					<p class="mt-3 text-sm leading-relaxed text-sec">
						Runners drive agents through their own CLIs, Codex through
						<span class="font-mono text-xs">codex app-server</span>, Claude Code through the
						<span class="font-mono text-xs">claude</span> CLI, using the sign-in already on the
						machine. Detent stores no model credentials.
					</p>
					<p class="mt-3 text-sm leading-relaxed text-sec">
						Model and reasoning effort are set per organization and project in the Hub. Pi and local
						models through Ollama are supported too. A Detent Cloud plan pays for hosting and
						concurrent work, never for tokens.
					</p>
				}
			</div>
		}
		@components.Section("04", "Comparison", "Including the rows Detent loses.",
			"This matrix is copied from docs/comparison.md in the repository. Where a competitor is better, the table says so.") {
			@components.Matrix(content.Matrix, content.Competitors)
			<p class="mt-4 font-mono text-2xs text-dim">
				&#10003; yes &#183; &#9680; partial &#183; &#10007; no &#183; &#8212; not applicable.
				Last verified { content.MatrixAsOf }; check vendor pricing and models before relying on them.
			</p>
			<div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
				for _, c := range content.Competitors {
					@components.Card("p-5") {
						<a
							href={ templ.SafeURL(c.URL) }
							class="inline-flex min-h-6 items-center font-mono text-xs text-accent hover:underline"
						>
							{ c.Name } &#8599;
						</a>
						<p class="mt-2 text-sm leading-relaxed text-sec">{ c.What }</p>
					}
				}
			</div>
			<p class="mt-6 max-w-[860px] text-sm leading-relaxed text-dim">
				Copilot and Cursor have closed much of the &#8220;runs near my code&#8221; gap and win
				zero-install inside their own platforms. They do not give you a board-native release runtime
				under your control. Hermes, OpenClaw, and Hyperagent reach more channels than Detent does.
			</p>
		}
		@components.Section("05", "Objections", "The questions people actually ask.", "") {
			<div class="grid gap-4 md:grid-cols-2">
				@objection("Will it ship garbage?",
					"Not without passing the gates you wrote: your gate command on the finished change, an automated validator, a security audit, or a person in Human Review. Then the runner that holds the project lands one change at a time, and a change that cannot land goes to Blocked with its reason.")
				@objection("What if the agent goes off the rails?",
					"It works on its own branch in its own worktree, and it cannot land anything; only the runner lands, after your gates clear. Moving the issue out of an active lane revokes the worker and stops its process. A worktree is collision isolation, not an OS sandbox, so the guarantee covers what lands. It does not limit what the process can touch.")
				@objection("Is it only for code?",
					"No. Lanes, roles, and the gate command are yours. A video pipeline or an approval workflow is a board with different lanes and a different definition of done.")
				@objection("Does my code go to Detent Cloud?",
					"Your checkout stays on your runners, and nothing that touches your code runs on the Hub. Change Requests do carry their diff to the Hub so people can review them, along with issues, comments, and run history. If that is too much, self-host the Hub for free.")
				@objection("Is this a toy?",
					"Judge it the way you would judge any repository: version history, a CI badge, a release channel, installer smoke tests on Ubuntu and Windows against real release assets, and the fact that it builds itself on Detent Cloud.")
				@objection("What is the catch?",
					"You bring the model cost, and you write the contracts. Detent will not invent your acceptance criteria, and it is not trying to. A vague issue produces vague work faster than before.")
			</div>
		}
		@partials.NextSteps("why-detent")
	}
}

func whyDetentMeta() meta.PageMeta {
	return meta.New(
		"Why Detent",
		"The contract-first interaction model versus autonomy-first agents, why the Hub coordinates while your machines do the work, and the full comparison matrix against Copilot, Cursor, Hermes, OpenClaw, and Hyperagent.",
	).WithNav("why-detent").WithPath("/why-detent")
}

templ audienceCard(title string, who string, need string) {
	@components.Card("flex flex-col p-6") {
		<h3 class="text-base font-semibold text-text">{ title }</h3>
		<p class="mt-3 text-sm leading-relaxed text-sec">{ who }</p>
		<p class="mt-3 text-sm leading-relaxed text-dim">{ need }</p>
	}
}

templ objection(question string, answer string) {
	@components.Card("p-6") {
		<h3 class="text-sm font-semibold text-text">{ question }</h3>
		<p class="mt-2.5 text-sm leading-relaxed text-sec">{ answer }</p>
	}
}
