package pages

import (
	"detent.build/internal/content"
	"detent.build/internal/meta"
	"detent.build/templates/layouts"
	"detent.build/templates/partials"
	"detent.build/ui/components"
)

templ Home() {
	@layouts.Base(homeMeta()) {
		@heroSection()
		@anyWorkSection()
		@definiteStatesSection()
		@partials.Inversion("03", false)
		@partials.HowItWorksSummary()
		@partials.MergeTrainSection("05")
		@partials.OperatorSurface()
		@partials.ContractsSection()
		@partials.ShipsItself("08")
		@partials.RunnersSection()
		@partials.InstallSection()
	}
}

// anyWorkSection makes the orchestration claim concrete: the lanes are the
// project's, so the same runtime moves code, video, or paperwork.
templ anyWorkSection() {
	<section id="lanes" class="mx-auto max-w-[1280px] scroll-mt-20 px-6 pt-24 md:px-8">
		@components.Eyebrow("", "Any kind of work")
		<h2 class="mt-3 max-w-[820px] text-2xl font-bold leading-tight text-text">Your lanes. Your definition of done.</h2>
		<p class="mt-4 max-w-[720px] text-base leading-relaxed text-sec">
			Detent is an orchestration layer, and the work it moves does not have to be code. A project&#39;s
			<span class="font-mono text-sm text-text">detent.yaml</span> names its lanes and gives each one a
			role: active lanes dispatch an agent, holding lanes wait, terminal lanes end the work. Code is
			one shape. A video pipeline or an office workflow is another.
		</p>
		<div class="mt-8 overflow-hidden rounded-card border border-line">
			for _, set := range content.LaneSets {
				<div class="grid gap-3 border-b border-line bg-surface px-5 py-4 last:border-b-0 md:grid-cols-[8rem_1fr] md:items-center">
					<div class="text-sm font-semibold text-text">{ set.Kind }</div>
					<div class="flex flex-wrap items-center gap-2 font-mono text-xs">
						for i, lane := range set.Lanes {
							if i > 0 {
								<span class="text-dim" aria-hidden="true">&#8594;</span>
							}
							<span
								class={ "whitespace-nowrap rounded-chip border px-2.5 py-1",
									templ.KV("border-warn text-warn", i == set.Gate),
									templ.KV("border-line text-sec", i != set.Gate) }
							>
								{ lane }
							</span>
						}
					</div>
				</div>
			}
		</div>
		<p class="mt-3 max-w-[840px] font-mono text-2xs leading-relaxed text-dim">
			Illustrative lane sets, not shipped templates. The amber lane is a holding lane that waits for a
			person; yours can sit anywhere, or nowhere.
		</p>
	</section>
}

func homeMeta() meta.PageMeta {
	return meta.New(
		content.HomeTitle,
		content.HomeDescription,
	).WithNav("home").WithPath("/")
}

templ heroSection() {
	<section class="relative overflow-hidden">
		<div class="pointer-events-none absolute inset-0 dt-grid opacity-[0.35]" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-[1280px] px-6 pb-4 pt-16 md:px-8 md:pt-20">
			<div class="flex flex-col justify-between gap-10 lg:flex-row lg:items-end">
				<div class="max-w-[720px]">
					@components.Eyebrow("", "Agent work orchestration · Detent Cloud or self-hosted")
					<h1 class="mt-4 text-2xl font-bold leading-[1.06] text-text sm:text-3xl">
						{ content.HomeHeadline }
					</h1>
					<p class="mt-5 max-w-[560px] text-lg text-sec">
						{ content.HomeHeroDeckBeforeTodo }<span class="font-mono text-base text-text">Todo</span>{ content.HomeHeroDeckAfterTodo }
					</p>
					<p class="mt-4 max-w-[560px] text-sm text-dim">
						{ content.HomeHeroStatement }
					</p>
				</div>
				<div class="flex w-full shrink-0 flex-col gap-2.5 lg:w-[420px]">
					<a
						href={ templ.SafeURL(content.CloudSignUpURL) }
						data-cloud-sign-up
						class="rounded-card border border-accent bg-accent px-5 py-3 text-center text-sm font-semibold text-page transition-opacity hover:opacity-90"
					>
						Start free on Detent Cloud
					</a>
					<div class="flex gap-2.5">
						<a
							href="/pricing"
							class="flex-1 rounded-card border border-line px-4 py-2.5 text-center text-sm text-sec transition-colors hover:border-accent hover:text-accent"
						>
							See plans
						</a>
						<a
							href="/install"
							class="flex-1 rounded-card border border-line px-4 py-2.5 text-center text-sm text-sec transition-colors hover:border-accent hover:text-accent"
						>
							Self-host
						</a>
					</div>
					<p class="px-1 font-mono text-2xs leading-relaxed text-dim">
						Free plan: 2 concurrent runs, no card. Self-hosting is free. { content.VersionFromCtx(ctx) } &#183; you bring the model cost.
					</p>
				</div>
			</div>
			<div class="mt-12">
				@components.Board(content.Board)
				<p class="mt-3 max-w-[840px] font-mono text-2xs leading-relaxed text-dim">
					{ content.BoardCaption }
					<a href="#lanes" class="text-accent hover:underline">Lanes for other kinds of work &#8593;</a>
				</p>
			</div>
		</div>
	</section>
}

templ definiteStatesSection() {
	@components.Section("02", "Definite states", content.DefiniteStatesHeading, content.DefiniteStatesDefinition) {
		<div class="grid gap-4 lg:grid-cols-3">
			@definiteStateCard(content.DefiniteStatesWhereQuestion, content.DefiniteStatesWhereAutonomy, content.DefiniteStatesWhereDetent)
			@definiteStateCard(content.DefiniteStatesWaitQuestion, content.DefiniteStatesWaitAutonomy, content.DefiniteStatesWaitDetent)
			@definiteStateCard(content.DefiniteStatesMoveQuestion, content.DefiniteStatesMoveAutonomy, content.DefiniteStatesMoveDetent)
		</div>
		<p class="mt-6 max-w-[840px] text-sm leading-relaxed text-dim">
			{ content.DefiniteStatesLaneRail }
		</p>
		<div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-2xs">
			<a href={ templ.SafeURL(content.DetentREADMEURL) } class="text-accent hover:underline">Why the name &#8599;</a>
			<a href={ templ.SafeURL(content.Doc("concepts.md")) } class="text-accent hover:underline">Promotion conditions &#8594;</a>
		</div>
	}
}

templ definiteStateCard(question string, autonomyFirst string, detent string) {
	@components.Card("flex flex-col p-5") {
		<h3 class="text-base font-semibold text-text">{ question }</h3>
		<dl class="mt-4 flex flex-1 flex-col">
			<div class="pb-4">
				<dt class="text-2xs font-semibold uppercase tracking-[0.06em] text-dim">Autonomy-first</dt>
				<dd class="mt-2 text-sm leading-relaxed text-sec">{ autonomyFirst }</dd>
			</div>
			<div class="flex-1 border-t border-line pt-4">
				<dt class="text-2xs font-semibold uppercase tracking-[0.06em] text-dim">Detent</dt>
				<dd class="mt-2 text-sm leading-relaxed text-sec">{ detent }</dd>
			</div>
		</dl>
	}
}
