package pages

import (
	"strconv"

	"detent.build/internal/content"
	"detent.build/internal/meta"
	"detent.build/templates/layouts"
	"detent.build/templates/partials"
	"detent.build/ui/components"
)

templ Pricing() {
	@layouts.Base(pricingMeta()) {
		@partials.PageHeader(
			"Pricing",
			"Start free. Pay for more work running at once.",
			"Detent Cloud prices each organization by how many runs it holds at the same time. Every plan, Free included, is the whole product: your runners, unlimited projects, members, repositories, and runners.",
		)
		@components.FirstSection("01", "Plans", "One product. The tiers differ in concurrent work.",
			"Concurrent work is the number of runs your organization has going at once. Each square below is one slot.") {
			<div class="overflow-hidden rounded-card border border-line">
				for _, plan := range content.Plans {
					@planRow(plan)
				}
			</div>
			<p class="mt-4 max-w-[760px] text-sm leading-relaxed text-dim">
				Every organization starts on Free. Owners upgrade from the organization&#39;s billing screen,
				and checkout runs on Stripe. Downgrading keeps your data and lets in-flight work finish.
				Prices are USD per organization per month.
			</p>
		}
		@components.Section("02", "What you get", "Free is not a trial.", "") {
			<div class="grid gap-4 lg:grid-cols-3">
				@components.Card("p-6") {
					<h3 class="text-base font-semibold text-text">Every plan</h3>
					<ul class="mt-4 flex flex-col gap-2.5 text-sm leading-relaxed text-sec">
						for _, item := range content.PlanIncludes {
							<li>{ item }</li>
						}
					</ul>
				}
				@components.Card("p-6") {
					<h3 class="text-base font-semibold text-text">Paid plans add</h3>
					<ul class="mt-4 flex flex-col gap-2.5 text-sm leading-relaxed text-sec">
						<li>More concurrent work: 8, 20, or 50 runs at once, or a custom allowance on Scale</li>
						<li>Hosted artifact storage, so run outputs outlive the runner that made them</li>
					</ul>
				}
				@components.Card("p-6") {
					<h3 class="text-base font-semibold text-text">Paid separately</h3>
					<ul class="mt-4 flex flex-col gap-2.5 text-sm leading-relaxed text-sec">
						<li>
							Model usage. Runners use the Codex or Claude Code sign-in already on the machine, so
							agent work bills against your own subscription or API key.
						</li>
						<li>Luna chat and hosted AI, which draw on AI credits rather than your plan.</li>
						<li>The machines your runners run on.</li>
					</ul>
				}
			</div>
		}
		@components.Section("03", "Counting", "How concurrent work is counted.", "") {
			<dl class="grid gap-x-10 gap-y-6 md:grid-cols-2">
				@pricingFact("What counts",
					"Every running attempt in the organization, whatever its stage. An issue waiting in a lane does not hold a slot.")
				@pricingFact("At the limit",
					"The next claim waits. The issue stays in its lane and is picked up as soon as a slot frees; nothing is refused when you file it.")
				@pricingFact("Open issues",
					"Every plan allows up to 10,000 open issues per organization. Done, Cancelled, and archived issues do not count.")
				@pricingFact("Projects, people, runners",
					"No plan limits projects, members, repositories, or runners. Enroll as many machines as you like; the plan caps how many runs go at once.")
			</dl>
		}
		<section class="mx-auto max-w-[1280px] px-6 pt-24 md:px-8">
			<div class="grid gap-6 rounded-card border border-line bg-surface p-8 md:grid-cols-[1fr_auto] md:items-center md:p-10">
				<div class="max-w-[640px]">
					@components.Eyebrow("04", "Self-hosted")
					<h2 class="mt-3 text-2xl font-bold text-text">Or run the Hub yourself, free.</h2>
					<p class="mt-3 text-base leading-relaxed text-sec">
						The Hub is the same binary. Self-hosting needs no Detent Cloud account, subscription, or
						billing, and no plan limits apply unless you configure them. You run one host and keep it
						backed up.
					</p>
				</div>
				<div class="flex flex-col gap-2.5 md:w-[240px]">
					<a
						href="/install"
						class="rounded-card border border-line px-4 py-2.5 text-center text-sm text-text transition-colors hover:border-accent hover:text-accent"
					>
						Self-host the Hub
					</a>
					<a
						href={ templ.SafeURL(content.Doc("hub-self-hosting.md")) }
						class="rounded-card border border-line px-4 py-2.5 text-center text-sm text-sec transition-colors hover:border-accent hover:text-accent"
					>
						Self-hosting guide
					</a>
				</div>
			</div>
			<p class="mt-4 font-mono text-2xs leading-relaxed text-dim">
				From Detent&#39;s capacity catalog as of { content.PricingAsOf }.
				<a href={ templ.SafeURL(content.Doc(content.PricingCatalogDoc)) } class="text-accent hover:underline">Hosted capacity allowances &#8594;</a>
			</p>
		</section>
		@partials.NextSteps("pricing")
	}
}

func pricingMeta() meta.PageMeta {
	return meta.New(
		"Pricing",
		"Detent Cloud plans: Free with 2 concurrent runs and no card, Starter $49, Team $99, Growth $249, and Scale. Every plan has unlimited projects, members, repositories, and runners. Self-hosting is free.",
	).WithNav("pricing").WithPath("/pricing")
}

templ planRow(plan content.Plan) {
	<div
		data-plan={ plan.Name }
		class="grid gap-4 border-b border-line bg-surface px-5 py-5 last:border-b-0 md:grid-cols-[11rem_7rem_1fr_11rem] md:items-center md:gap-6"
	>
		<div>
			<h3 class="text-base font-semibold text-text">{ plan.Name }</h3>
			<p class="mt-1 text-xs leading-relaxed text-dim">{ plan.Summary }</p>
		</div>
		<div class="flex items-baseline gap-1">
			if plan.Price == "" {
				<span class="text-lg font-semibold text-text">Custom</span>
			} else {
				<span class="text-lg font-semibold tabular-nums text-text">${ plan.Price }</span>
				<span class="text-xs text-dim">/ month</span>
			}
		</div>
		<div class="flex flex-col gap-2">
			<div class="font-mono text-xs text-sec">
				if plan.ConcurrentWork == 0 {
					custom concurrent work
				} else {
					<span class="tabular-nums text-text">{ strconv.Itoa(plan.ConcurrentWork) }</span> concurrent
				}
			</div>
			@capacityStrip(plan.ConcurrentWork)
		</div>
		<div class="md:text-right">
			@planAction(plan)
		</div>
	</div>
}

// capacityStrip draws a plan's concurrent work on the scale of the largest
// self-serve allowance, so the tiers compare at a glance. A custom allowance
// is drawn as an outline: there is no number to fill.
templ capacityStrip(slots int) {
	<div
		class="grid max-w-[520px] grid-cols-[repeat(25,minmax(0,1fr))] gap-[3px] sm:grid-cols-[repeat(50,minmax(0,1fr))]"
		aria-hidden="true"
	>
		for i := 0; i < content.MaxPlanConcurrentWork; i++ {
			<span
				class={ "block h-2.5 rounded-[1px]",
					templ.KV("bg-ok", i < slots),
					templ.KV("bg-line", slots > 0 && i >= slots),
					templ.KV("border border-dashed border-line", slots == 0) }
			></span>
		}
	</div>
}

templ planAction(plan content.Plan) {
	switch  {
		case plan.Price == "0":
			<a
				href={ templ.SafeURL(content.CloudSignUpURL) }
				data-cloud-sign-up
				class="inline-flex rounded-card border border-accent bg-accent px-4 py-2 text-sm font-semibold text-page transition-opacity hover:opacity-90"
			>
				Create a free account
			</a>
		case plan.Price == "":
			<a
				href={ templ.SafeURL(content.ContactURL) }
				class="inline-flex rounded-card border border-line px-4 py-2 text-sm text-text transition-colors hover:border-accent hover:text-accent"
			>
				Contact us
			</a>
		default:
			<a
				href={ templ.SafeURL(content.CloudSignUpURL) }
				class="inline-flex rounded-card border border-line px-4 py-2 text-sm text-text transition-colors hover:border-accent hover:text-accent"
			>
				Start free, then upgrade
			</a>
	}
}

templ pricingFact(term string, detail string) {
	<div class="border-t border-line pt-4">
		<dt class="text-sm font-semibold text-text">{ term }</dt>
		<dd class="mt-2 max-w-[560px] text-sm leading-relaxed text-sec">{ detail }</dd>
	</div>
}
