package pages

import (
	"detent.build/internal/content"
	"detent.build/internal/meta"
	"detent.build/templates/layouts"
	"detent.build/templates/partials"
	"detent.build/ui/components"
)

templ OpenSource() {
	@layouts.Base(openSourceMeta()) {
		@partials.PageHeader(
			"Open source",
			"MIT. Free. Self-hosted. No control plane.",
			"There is no hosted tier, no per-seat charge, and nothing to sign up for. You bring the model cost, and that is the whole business model.",
		)
		@components.Section("01", "The terms", "Short version, on one screen.", "") {
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				@termCard("License", "MIT", content.LicenseURL)
				@termCard("Current release", content.Version, content.ReleasesURL)
				@termCard("Source", "digitaldrywood/detent", content.RepoURL)
				@termCard("CI", "GitHub Actions", content.CIURL)
			</div>
			<p class="mt-4 max-w-[760px] text-sm leading-relaxed text-dim">
				Detent runs fully local and is air-gappable. It has no vendor control plane, which means
				there is no service that can revoke your access, change your pricing, or read your board.
				The trade is that operating it is your job.
			</p>
		}
		@partials.ShipsItself("02")
		@components.Section("03", "Proof points", "Claims the repository can substantiate.",
			"Every line here maps to something checked in, released, or running. Nothing on this site is a projection.") {
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				for _, p := range content.ProofPoints {
					@components.Card("p-5") {
						<h3 class="text-sm font-semibold text-text">{ p.Title }</h3>
						<p class="mt-2 text-xs leading-relaxed text-sec">{ p.Body }</p>
					}
				}
			</div>
			<div class="mt-4 rounded-card border border-line bg-page p-6">
				<h3 class="text-sm font-semibold text-text">And the honest caveats</h3>
				<ul class="mt-3 flex max-w-[820px] flex-col gap-2.5 text-sm leading-relaxed text-sec">
					<li>
						Code is the proven domain. The same status-to-gated-review-to-done shape is the
						trajectory for non-code work &#8212; validation gates are already pluggable, but
						non-git and non-PR deliverables remain follow-up work.
					</li>
					<li>
						Model-agnostic is partial, not done. Codex is the shipped backend; the routing seam
						exists and Claude Code is supported per role, but this is a &#9680; in the matrix, not
						a &#10003;.
					</li>
					<li>
						Release signing is not finished. Self-update verifies published SHA-256 checksums over
						GitHub TLS; enforcement of detached minisign signatures is gated until the binary
						embeds a pinned public key.
					</li>
					<li>
						It is a young project. Judge it on the version history, the CI badge, the installer
						smoke tests against real release assets on Ubuntu and Windows, and the fact that it
						builds itself &#8212; not on a logo wall, because there is not one.
					</li>
				</ul>
			</div>
		}
		@components.Section("04", "Lineage", "Where this came from.",
			"Detent grew out of OpenAI's Symphony — the open spec for orchestrating Codex agents from a project board instead of supervising them interactively. That lineage is a credibility asset, not something to bury.") {
			<div class="grid gap-4 lg:grid-cols-2">
				@components.Card("p-6") {
					<h3 class="text-base font-semibold text-text">What Symphony is</h3>
					<p class="mt-3 text-sm leading-relaxed text-sec">
						An Apache-2.0 <span class="font-mono text-xs">SPEC.md</span> plus an Elixir reference
						implementation that polls a Linear board. Its slogan &#8212; manage work, not agents
						&#8212; is the idea Detent is built on.
					</p>
					<a href={ templ.SafeURL(content.SymphonyURL) } class="mt-3 inline-block font-mono text-xs text-accent hover:underline">
						openai/symphony &#8599;
					</a>
				}
				@components.Card("p-6") {
					<h3 class="text-base font-semibold text-text">Where Detent diverged</h3>
					<ul class="mt-3 flex flex-col gap-2 text-sm leading-relaxed text-sec">
						<li>A product, not a spec: one CGO-free Go binary instead of a BEAM service.</li>
						<li>GitHub Projects v2, issue fields, or labels &#8212; not Linear.</li>
						<li>Multi-project from one host, with weights, priority, pause, and fair scheduling.</li>
						<li>Explicit gates plus a serialized merge train.</li>
						<li>A real operator surface, <span class="font-mono text-xs">detent doctor</span>, Windows support, and a GoReleaser pipeline.</li>
					</ul>
					<p class="mt-3 text-xs leading-relaxed text-dim">
						Detent itself began as an Elixir/OTP implementation adapted from Symphony&#39;s Linear
						target to GitHub Projects. It is now a ground-up Go rewrite; the Elixir implementation
						is archived.
					</p>
				}
			</div>
		}
		@components.Section("05", "Contributing", "The same gates apply to you.",
			"Detent's board dispatches agents against its own contracts, and human pull requests go through the same validation gate and the same merge train.") {
			<div class="grid gap-4 md:grid-cols-3">
				@linkCard("Contributing guide", "How to set up, what make check runs, and the review conventions.", content.ContributingURL)
				@linkCard("Issues", "Where work starts. A well-specified issue is the unit Detent operates on.", content.IssuesURL)
				@linkCard("Development", "Repository layout, local runs, and the validation gate.", content.Doc("development.md"))
			</div>
		}
		@partials.NextSteps("open-source")
	}
}

func openSourceMeta() meta.PageMeta {
	return meta.New(
		"Open source",
		"Detent is MIT licensed, free, and self-hosted with no vendor control plane. The license, releases, contributing guide, the Symphony lineage, and the self-hosting proof via detent-orchestration.",
	).WithNav("open-source").WithCanonical("https://detent.build/open-source")
}

templ termCard(label string, value string, href string) {
	<a
		href={ templ.SafeURL(href) }
		class="group rounded-card border border-line bg-surface p-5 transition-colors hover:border-accent"
	>
		<div class="font-mono text-2xs uppercase tracking-[0.06em] text-dim">{ label }</div>
		<div class="mt-2 truncate font-mono text-sm text-text transition-colors group-hover:text-accent">{ value }</div>
	</a>
}

templ linkCard(title string, body string, href string) {
	<a
		href={ templ.SafeURL(href) }
		class="group rounded-card border border-line bg-surface p-5 transition-colors hover:border-accent"
	>
		<h3 class="text-sm font-semibold text-text transition-colors group-hover:text-accent">{ title } &#8599;</h3>
		<p class="mt-2 text-sm leading-relaxed text-sec">{ body }</p>
	</a>
}
