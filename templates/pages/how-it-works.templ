package pages

import (
	"detent.build/internal/content"
	"detent.build/internal/meta"
	"detent.build/templates/layouts"
	"detent.build/templates/partials"
	"detent.build/ui/components"
)

templ HowItWorks() {
	@layouts.Base(howItWorksMeta()) {
		@partials.PageHeader(
			"How it works",
			"The mechanism, stop by stop.",
			"The Hub's board is the state machine, and your workflow defines its lanes. Everything below is behavior the runtime actually implements; each step links to the document that specifies it.",
		)
		@components.FirstSection("01", "The state machine", content.HowItWorksStateHeading, content.HowItWorksStateDetail) {
			@components.LaneRail()
			<div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
				for _, lane := range content.Lanes {
					@components.Card("p-5") {
						<div class="font-mono text-xs text-text">{ lane.Name }</div>
						<p class="mt-2 text-sm leading-relaxed text-sec">{ lane.Blurb }</p>
					}
				}
			</div>
			<p class="mt-4 max-w-[760px] text-sm leading-relaxed text-dim">
				Each lane in <span class="font-mono text-xs text-sec">detent.yaml</span> has a role:
				<span class="font-mono text-xs text-sec">active</span> lanes dispatch an agent,
				<span class="font-mono text-xs text-sec">holding</span> lanes wait, and
				<span class="font-mono text-xs text-sec">terminal</span> lanes end the work. The board lives on
				the Hub; GitHub issues can be imported into it, but the Hub&#39;s board stays the
				source of truth. Nothing here is specific to code.
				<a href={ templ.SafeURL(content.Doc("concepts.md")) } class="text-accent hover:underline">Concepts: tracker and board states &#8594;</a>
			</p>
		}
		@components.Section("02", "The mechanism", "Six steps, in the order they happen.", "") {
			<ol class="flex flex-col gap-3">
				for _, step := range content.Steps {
					@stepRow(step)
				}
			</ol>
		}
		@components.Section("03", "Isolation", "One worktree per issue, and where that isolation stops.",
			"Every claimed issue gets its own Git worktree from your source checkout, and its own branch. That is collision isolation, and it is worth being precise about where it stops.") {
			<div class="grid gap-4 lg:grid-cols-2">
				@components.Card("p-6") {
					<div class="font-mono text-xs text-ok">What the worktree and the gates do</div>
					<ul class="mt-4 flex flex-col gap-2.5 text-sm leading-relaxed text-sec">
						<li>A worktree per issue, so no two agents share a working tree or fight over the index.</li>
						<li>A branch per issue, so no agent commits onto your main line.</li>
						<li>Your gate command runs on the finished change.</li>
						<li>Promotion is decided by the gates you configured, not by the agent.</li>
						<li>Moving an issue out of an active lane revokes the running worker and stops its process group.</li>
						<li>The runner that holds the project, not the agent, lands every change.</li>
					</ul>
				}
				@components.Card("p-6") {
					<div class="font-mono text-xs text-warn">What it is not</div>
					<p class="mt-4 text-sm leading-relaxed text-sec">
						A Git worktree is not an OS sandbox, and
						<span class="font-mono text-xs text-text">WORKFLOW.md</span> is an instruction to the
						agent rather than a capability boundary. The agent process has whatever host,
						filesystem, and network access the runner machine and its agent CLI allow.
					</p>
					<p class="mt-3 text-sm leading-relaxed text-sec">
						What the gates and serialized landing guarantee is about
						<em>promotion</em>: nothing lands on your main branch without clearing them. Treat the
						agent as a trusted process you have configured, not as a contained one, and choose what
						each runner machine can reach deliberately.
					</p>
					<a
						href={ templ.SafeURL(content.Doc("project-delivery.md")) }
						class="mt-3 inline-flex min-h-6 items-center font-mono text-2xs text-accent hover:underline"
					>
						Designing a project for reliable delivery &#8594;
					</a>
				}
			</div>
		}
		@components.Section("04", "Gates", "A gate is a condition you wrote down.",
			"The workflow decides what a change needs before it advances. These are the shipped options, and they compose.") {
			<div class="grid gap-4 md:grid-cols-2">
				@gateCard("Gate command", "gate.run is your check command, run on the finished change. Detent's own is make check-landing; yours can render a video or validate a document.")
				@gateCard("Human Review", "With review.human: true, a Change Request waits in Human Review until a person approves it or sends it back. This is the detent in its most literal form.")
				@gateCard("Automated validator", "A model scores the change against the issue's acceptance criteria and can send unverified work back for another pass.")
				@gateCard("Security audit", "An independent audit pass on the change before it can land.")
			</div>
			<p class="mt-4 max-w-[760px] text-sm leading-relaxed text-dim">
				With the default <span class="font-mono text-xs text-sec">review.human: false</span>, an accepted
				change goes straight to <span class="font-mono text-xs text-sec">Merging</span>. Detent&#39;s own
				config sends a failed gate back to <span class="font-mono text-xs text-sec">Rework</span> with its
				output.
				<a href={ templ.SafeURL(content.Doc("native-review.md")) } class="text-accent hover:underline">Native review &#8594;</a>
			</p>
		}
		@partials.MergeTrainSection("05")
		@components.Section("06", "Admission", "Deciding what is even worth dispatching.",
			"Admission criteria are project-owned text in your workflow: the sections an issue must contain before an agent picks it up. Admission and Todo dispatch use one evaluator, so a vague issue waits instead of producing vague work.") {
			@components.CodeSurface("WORKFLOW.md", "the default issue contract") {
				<span class="text-text">{ "## Issue Contract" }</span>{ "\n\n" }
				{ "- Acceptance criteria\n" }
				{ "- Must not break\n" }
				{ "- How we know it worked" }
			}
			<p class="mt-4 max-w-[760px] text-sm leading-relaxed text-dim">
				These three sections are the default when a project configures none. Required sections must
				contain text; headings inside code fences do not count.
				<a href={ templ.SafeURL(content.Doc("admission.md")) } class="text-accent hover:underline">Admission criteria &#8594;</a>
			</p>
		}
		@partials.NextSteps("how-it-works")
	}
}

func howItWorksMeta() meta.PageMeta {
	return meta.New(
		"How it works",
		"How Detent works: a Hub holds the board, runners you enroll do the work, your workflow defines the lanes and gates, and changes land one at a time.",
	).WithNav("how-it-works").WithPath("/how-it-works")
}

templ stepRow(step content.Step) {
	<li class="rounded-card border border-line bg-surface p-6">
		<div class="grid gap-5 md:grid-cols-[3rem_1fr]">
			<div class="font-mono text-xl font-semibold text-accent">{ pad(step.Num) }</div>
			<div>
				<h3 class="text-base font-semibold text-text">{ step.Title }</h3>
				<p class="mt-2 max-w-[760px] text-sm leading-relaxed text-sec">{ step.Body }</p>
				if step.Detail != "" {
					<p class="mt-2 max-w-[760px] text-sm leading-relaxed text-dim">{ step.Detail }</p>
				}
				if step.DocPath != "" {
					<a
						href={ templ.SafeURL(content.Doc(step.DocPath)) }
						class="mt-3 inline-flex min-h-6 items-center font-mono text-2xs text-accent hover:underline"
					>
						{ step.DocName } &#8594;
					</a>
				}
			</div>
		</div>
	</li>
}

templ gateCard(title string, body string) {
	@components.Card("p-6") {
		<div class="flex items-center gap-2 font-mono text-xs text-warn">
			<span aria-hidden="true">&#9666;</span>
			{ title }
		</div>
		<p class="mt-3 text-sm leading-relaxed text-sec">{ body }</p>
	}
}

func pad(n int) string {
	return "0" + string(rune('0'+n))
}
