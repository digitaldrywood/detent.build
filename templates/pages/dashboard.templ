package pages

import (
	"detent.build/internal/content"
	"detent.build/internal/meta"
	"detent.build/templates/layouts"
	"detent.build/templates/partials"
	"detent.build/ui/components"
)

templ Dashboard() {
	@layouts.Base(dashboardMeta()) {
		@partials.PageHeader(
			"Dashboard",
			"The board stays honest.",
			"The Hub's web app, its MCP endpoint, and the CLI read the same state. \"In progress\" means an agent is working right now, not that someone forgot to move a card.",
		)
		<section class="mx-auto max-w-[1280px] px-6 pt-14 md:px-8">
			<figure>
				<img
					src="/static/images/dashboard-dark.png"
					alt="The Detent dashboard: a project sidebar, a header row of running, queued, waiting, blocked, and completed counts, and Kanban lanes for Backlog, Blocked, Human Review, and Review with issue cards showing repository, title, dispatch source, and waiting reason."
					width="2972"
					height="1745"
					class="block w-full rounded-card border border-line"
				/>
				<figcaption class="mt-3 font-mono text-2xs text-dim">
					A real board across nine projects, from an earlier release. Note the waiting reasons on the
					blocked cards — the board says why something is stopped, not just that it is.
				</figcaption>
			</figure>
		</section>
		@components.Section("01", "What it shows", "Instrument panel, not a status page.", "") {
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
				@surfaceCard("Live counts", "Running, queued, waiting, blocked, and completed over the last 48 hours, across every project in the organization.")
				@surfaceCard("Running agents", "Which issue each agent has, how long it has been working, and what it is doing right now — dispatch, gate command, Change Request.")
				@surfaceCard("Why something is stopped", "Not just the lane. The actual reason: dependency not ready, project paused, plan capacity reached, landing refused with its reason.")
				@surfaceCard("Token, budget, and rate limit", "Live spend against your cap and the current rate-limit posture, so a run that is about to hit a wall is visible before it does.")
				@surfaceCard("Reports and activity", "Reports, an activity feed, and saved Work views — where work is accumulating and how long it sits in each lane.")
				@surfaceCard("Density and staleness", "Compact, cozy, and comfy card densities, in the same Templ and HTMX shell on desktop and narrow screens.")
			</div>
			<p class="mt-4 max-w-[760px] text-sm leading-relaxed text-dim">
				The dashboard is also an API. Everything the browser renders is available as JSON.
				<a href={ templ.SafeURL(content.Doc("dashboard-api.md")) } class="text-accent hover:underline">Dashboard and APIs &#8594;</a>
			</p>
		}
		@components.Section("02", "The lanes", content.DashboardLaneHeading,
			"The Hub's native board holds the lanes. GitHub issues can be imported into it; they are not the source of truth.") {
			@components.Board(content.Board)
			<p class="mt-3 max-w-[840px] font-mono text-2xs leading-relaxed text-dim">
				{ content.BoardCaption }
				<a href="/#lanes" class="text-accent hover:underline">Lanes for other kinds of work &#8594;</a>
			</p>
		}
		@components.Section("03", "Beyond the browser", "Your own agent can read the board.",
			"The Hub exposes its board, issues, changes, runners, and settings over MCP, and the CLI reads the same state.") {
			<div class="grid gap-4 lg:grid-cols-[1fr_320px]">
				@components.Terminal("from a runner or your laptop") {
					<span class="text-dim">{ "$ " }</span>{ "detent state\n" }
					<span class="text-dim">{ "  fleet and project state\n\n" }</span>
					<span class="text-dim">{ "$ " }</span>{ "detent issue\n" }
					<span class="text-dim">{ "  issue explanation reads\n\n" }</span>
					<span class="text-dim">{ "$ " }</span>{ "detent report\n" }
					<span class="text-dim">{ "  operations report export" }</span>
				}
				@components.Card("p-5") {
					<p class="text-sm leading-relaxed text-sec">
						Create a key in Settings &#8250; API &amp; MCP and point your client at your
						organization&#39;s MCP endpoint. Your agent can file issues, read run history, and
						review changes.
					</p>
					<a href={ templ.SafeURL(content.Doc("api-mcp-setup.md")) } class="mt-3 inline-flex min-h-6 items-center font-mono text-xs text-accent hover:underline">
						API &amp; MCP setup &#8594;
					</a>
				}
			</div>
		}
		@components.Section("04", "Design rules", "The same system this site is built in.",
			"The dashboard's palette, type scale, and geometry are the ones you are reading right now — the marketing site imports the product's tokens rather than approximating them.") {
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				@ruleCard("Four semantics, one accent", "ok, warn, error, info — and teal for interactivity only. Never a fifth semantic, and never accent for status.")
				@ruleCard("Hairlines, not shadows", "1px borders carry every boundary. Card radius 6px, chip radius 4px, on a strict 4px spacing grid.")
				@ruleCard("Mono means machine", "State names, config, CLI output, and lane labels are set in Geist Mono because they are literal strings, not decoration.")
				@ruleCard("One thing animates", "A 6px pulsing dot per active agent, and the held card's ring. Reduced-motion turns both off.")
			</div>
		}
		@partials.NextSteps("dashboard")
	}
}

func dashboardMeta() meta.PageMeta {
	return meta.New(
		"Dashboard",
		"A tour of the Detent operator surface: live lanes, running agents, waiting reasons, token and budget and rate-limit state, board flow charts, and the terminal UI.",
	).WithNav("dashboard").WithPath("/dashboard")
}

templ surfaceCard(title string, body string) {
	@components.Card("p-5") {
		<h3 class="text-sm font-semibold text-text">{ title }</h3>
		<p class="mt-2 text-sm leading-relaxed text-sec">{ body }</p>
	}
}

templ ruleCard(title string, body string) {
	@components.Panel("p-5") {
		<h3 class="font-mono text-xs text-text">{ title }</h3>
		<p class="mt-2 text-xs leading-relaxed text-sec">{ body }</p>
	}
}
