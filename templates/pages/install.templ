package pages

import (
	"detent.build/internal/content"
	"detent.build/internal/meta"
	"detent.build/templates/layouts"
	"detent.build/templates/partials"
	"detent.build/ui/components"
)

templ Install(target content.InstallTarget) {
	@layouts.Base(installMeta(target)) {
		@partials.PageHeader(
			"Self-host",
			"One binary. It is the runner, and it can be the Hub.",
			"Every setup installs Detent on the machines that do the work. Enroll them against Detent Cloud, or run your own Hub on one host for free.",
		)
		@components.FirstSection("01", "Install", "Pick your platform.", "macOS, Linux, and Windows, as one CGO-free binary.") {
			<div class="grid gap-4 lg:grid-cols-[1fr_380px]">
				@partials.InstallTabs(target)
				@components.Card("h-fit p-5") {
					<div class="font-mono text-2xs uppercase tracking-[0.06em] text-dim">Also available</div>
					<ul class="mt-3 flex flex-col gap-2 font-mono text-xs text-sec">
						<li>go install</li>
						<li>Homebrew (macOS and Linux)</li>
						<li>Winget and Scoop</li>
						<li>.deb and .rpm</li>
						<li>or copy a single file</li>
					</ul>
					<p class="mt-4 text-xs leading-relaxed text-dim">
						Release self-updates verify SHA-256 checksums fetched from GitHub releases. Update
						integrity currently rests on GitHub TLS plus the published checksum file; release
						signing with a pinned minisign key is still open work, and the repository says so.
					</p>
				}
			</div>
		}
		@components.Section("02", "Requirements", "What has to be on the host.",
			"A runner dispatches agents from the machine it runs on, so the agent CLI and its login live there too.") {
			<div class="overflow-hidden rounded-card border border-line">
				for _, req := range content.Requirements {
					<div class="flex flex-col gap-3 border-b border-line bg-surface p-5 last:border-b-0 md:flex-row md:items-start md:justify-between">
						<div class="max-w-[640px]">
							<div class="flex items-center gap-2.5">
								<h3 class="text-sm font-semibold text-text">{ req.Name }</h3>
								if req.Optional {
									@components.Chip("") {
										optional
									}
								}
							</div>
							<p class="mt-1.5 text-sm leading-relaxed text-sec">{ req.Detail }</p>
						</div>
						<code class="shrink-0 rounded-chip border border-line bg-page px-2.5 py-1 font-mono text-2xs text-dim">
							{ req.Verify }
						</code>
					</div>
				}
			</div>
		}
		@components.Section("03", "First run", "Enroll a runner, or start your own Hub.", "") {
			<div class="grid gap-4 lg:grid-cols-2">
				@components.Terminal("enroll a runner") {
					<span class="text-dim">{ "# Settings › Providers & runners › Enroll a runner shows this command\n" }</span>
					<span class="text-dim">{ "$ " }</span>{ "detent hub runner register \\\n" }
					{ "    --url https://cloud.detent.build/organizations/ORGANIZATION_ID \\\n" }
					{ "    --token TOKEN --name \"Build host\" --service\n\n" }
					<span class="text-dim">{ "$ " }</span>{ "detent doctor\n" }
					<span class="text-dim">{ "  read-only checks of config resolution and project tokens" }</span>
				}
				@components.Terminal("run your own Hub") {
					<span class="text-dim">{ "$ " }</span>{ "DETENT_HUB_ADMIN_TOKEN=... detent hub serve \\\n" }
					{ "    --database /var/lib/detent-hub/hub.db \\\n" }
					{ "    --listen 127.0.0.1:7777 --github-disabled\n\n" }
					<span class="text-dim">{ "  put a TLS proxy in front, create the organization and\n  project, then enroll runners with your Hub's URL" }</span>
				}
			</div>
			<div class="mt-4 rounded-card border border-line bg-page p-6">
				<h3 class="text-sm font-semibold text-text">Then let an agent set it up</h3>
				<p class="mt-2 max-w-[760px] text-sm leading-relaxed text-sec">
					Detent is meant to be set up by an agent. The README carries a prompt to paste into Codex or
					Claude Code from inside the repository you want Detent to work on. It asks whether you use
					Detent Cloud or a self-hosted Hub, inspects the repository, drafts
					<span class="font-mono text-xs">detent.yaml</span> and
					<span class="font-mono text-xs">WORKFLOW.md</span> as drafts you approve, and asks before every
					change to the Hub, the repository, or the runner.
				</p>
				<div class="mt-4 flex flex-wrap gap-3">
					<a
						href={ templ.SafeURL(content.RepoURL + "#start-with-ai") }
						class="rounded-card border border-line px-4 py-2 font-mono text-xs text-sec transition-colors hover:border-accent hover:text-accent"
					>
						Start with AI &#8599;
					</a>
					<a
						href={ templ.SafeURL(content.Doc("cloud-onboarding.md")) }
						class="rounded-card border border-line px-4 py-2 font-mono text-xs text-sec transition-colors hover:border-accent hover:text-accent"
					>
						Cloud onboarding &#8594;
					</a>
					<a
						href={ templ.SafeURL(content.Doc("hub-self-hosting.md")) }
						class="rounded-card border border-line px-4 py-2 font-mono text-xs text-sec transition-colors hover:border-accent hover:text-accent"
					>
						Self-hosted Hub operations &#8594;
					</a>
				</div>
			</div>
		}
		@components.Section("04", "Updating", "Whatever installed it should update it.", "") {
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				@updateCard("Release installer", "detent update", "Use --yes for automation. On a runner, detent update --yes drains running work before it restarts.")
				@updateCard("Homebrew", "brew upgrade digitaldrywood/tap/detent", "")
				@updateCard("Winget and Scoop", "winget upgrade --id DigitalDrywood.Detent", "Or scoop update detent.")
				@updateCard("Go install", "detent update --from-release", "Switches a go-installed binary to the checksum-verified release asset and pins future updates to release-binary management.")
			</div>
		}
		@partials.NextSteps("install")
	}
}

func installMeta(target content.InstallTarget) meta.PageMeta {
	return meta.New(
		"Self-host: "+target.Label,
		"Install Detent on macOS, Linux, or Windows to enroll a runner against Detent Cloud or run your own Hub: Homebrew, the checksum-verified shell and PowerShell installers, Winget, Scoop, .deb, .rpm, or go install.",
	).WithNav("install").WithPath("/install")
}

templ updateCard(title string, cmd string, note string) {
	@components.Card("flex flex-col p-5") {
		<h3 class="text-sm font-semibold text-text">{ title }</h3>
		<code class="mt-2.5 block overflow-x-auto whitespace-pre rounded-chip border border-line bg-page px-2.5 py-1.5 font-mono text-2xs text-sec">
			{ cmd }
		</code>
		if note != "" {
			<p class="mt-2.5 text-xs leading-relaxed text-dim">{ note }</p>
		}
	}
}
