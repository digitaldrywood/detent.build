package layouts

import (
	"detent.build/internal/content"
	"detent.build/ui/components"
)

type navItem struct {
	Key   string
	Label string
	Href  string
}

var navItems = []navItem{
	{"how-it-works", "How it works", "/how-it-works"},
	{"why-detent", "Why Detent", "/why-detent"},
	{"dashboard", "Dashboard", "/dashboard"},
	{"install", "Install", "/install"},
	{"docs", "Docs", "/docs"},
	{"open-source", "Open source", "/open-source"},
}

templ Nav(current string) {
	<header class="sticky top-0 z-40 border-b border-line bg-page/85 backdrop-blur">
		<nav class="mx-auto flex h-14 max-w-[1280px] items-center gap-6 px-6 md:px-8" aria-label="Primary">
			<a href="/" class="flex shrink-0 items-center gap-2.5 rounded-chip" aria-label="detent.build home">
				@components.Mark("size-6 text-brand-lift")
				@components.Wordmark("text-[15px]")
			</a>
			<div class="ml-2 hidden items-center gap-7 text-sm lg:flex">
				for _, item := range navItems {
					@navLink(item, current)
				}
			</div>
			<div class="ml-auto flex items-center gap-2.5">
				<a
					href={ templ.SafeURL(content.ReleasesURL) }
					class="hidden rounded-chip border border-line px-2 py-1 font-mono text-2xs text-dim transition-colors hover:border-accent hover:text-accent sm:inline-block"
				>
					{ content.VersionFromCtx(ctx) } &#183; { content.License }
				</a>
				@ThemeToggle()
				<a
					href={ templ.SafeURL(content.RepoURL) }
					class="rounded-card border border-line px-3 py-1.5 font-mono text-xs text-text transition-colors hover:border-accent hover:text-accent"
				>
					GitHub &#8599;
				</a>
			</div>
		</nav>
		<div class="border-t border-line lg:hidden">
			<div class="mx-auto flex max-w-[1280px] gap-5 overflow-x-auto px-6 py-2 text-xs md:px-8">
				for _, item := range navItems {
					@navLink(item, current)
				}
			</div>
		</div>
	</header>
}

templ navLink(item navItem, current string) {
	<a
		href={ templ.SafeURL(item.Href) }
		class={ "inline-flex min-h-6 items-center whitespace-nowrap py-1 transition-colors hover:text-accent",
			templ.KV("text-accent", item.Key == current),
			templ.KV("text-sec", item.Key != current) }
		if item.Key == current {
			aria-current="page"
		}
	>
		{ item.Label }
	</a>
}

// ThemeToggle flips between the dark default and light. The product ships both
// and so does the site; neither is an afterthought.
templ ThemeToggle() {
	<button
		type="button"
		data-theme-toggle
		aria-label="Toggle light and dark theme"
		class="flex size-7 items-center justify-center rounded-chip border border-line text-dim transition-colors hover:border-accent hover:text-accent"
	>
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-3.5" aria-hidden="true">
			<circle cx="12" cy="12" r="4.5"></circle>
			<path
				d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"
				stroke-linecap="round"
			></path>
		</svg>
	</button>
	<script>
		document.addEventListener("click", function (event) {
			var button = event.target.closest("[data-theme-toggle]");
			if (!button) return;
			var root = document.documentElement;
			var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
			root.setAttribute("data-theme", next);
			try {
				localStorage.setItem("detent-theme", next);
			} catch (e) {
				/* nothing to persist to; the toggle still works for this page */
			}
		});
	</script>
}
