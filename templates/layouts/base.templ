package layouts

import (
	"detent.build/components/copybutton"
	"detent.build/internal/meta"
)

templ Base(m meta.PageMeta) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@MetaTags(m)
			<link rel="icon" href="/static/images/detent-mark.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			@themeScript()
			<script src="/static/js/htmx.min.js" defer></script>
			@copybutton.Script()
		</head>
		<body class="min-h-screen bg-page text-text antialiased">
			<a
				href="#main"
				class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-chip focus:border focus:border-accent focus:bg-surface focus:px-3 focus:py-2 focus:font-mono focus:text-xs focus:text-accent"
			>
				Skip to content
			</a>
			@Nav(m.NavKey)
			<main id="main">
				{ children... }
			</main>
			@Footer()
		</body>
	</html>
}

// themeScript sets the stored theme before first paint so a light-mode reader
// never sees a dark flash. Dark is the default, as it is in the product.
templ themeScript() {
	<script>
		(function () {
			try {
				var stored = localStorage.getItem("detent-theme");
				if (stored === "light" || stored === "dark") {
					document.documentElement.setAttribute("data-theme", stored);
				}
			} catch (e) {
				/* private mode: keep the dark default */
			}
		})();
	</script>
}
