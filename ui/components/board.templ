package components

import "detent.build/internal/content"

// Board is the hero visual: Detent's production delivery path with real work
// and exactly one card held at a gate. It is the product's most recognizable
// surface, so the marketing site leads with the thing itself rather than a
// screenshot of it.
templ Board(columns []content.BoardColumn) {
	<div class="overflow-hidden rounded-card border border-line bg-page">
		@boardHeader()
		<div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6">
			for i, col := range columns {
				@boardLane(col, i == len(columns)-1)
			}
		</div>
	</div>
}

templ boardHeader() {
	<div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-line px-4 py-2.5 font-mono text-2xs text-dim">
		<span class="text-sec">{ content.BoardLabel }</span>
		<span><span class="text-text">2</span> working</span>
		<span><span class="text-warn">1</span> held at gate</span>
		<span class="hidden sm:inline">
			<span class="text-text">{ content.MergedPRs }</span> merged, all time
		</span>
		<span class="ml-auto hidden lg:inline">tokens · budget · rate limit — all on the dashboard</span>
	</div>
}

templ boardLane(col content.BoardColumn, last bool) {
	<div
		class={ "p-3 xl:min-h-[15rem]", templ.KV("xl:border-r xl:border-line", !last),
			templ.KV("bg-surface/40", col.Lane.Slug == "human-review") }
	>
		<div class="mb-2.5 flex items-baseline justify-between font-mono text-2xs uppercase tracking-[0.06em] text-dim">
			<span class="truncate">{ col.Lane.Name }</span>
			<span class="pl-2 tabular-nums">{ col.Count }</span>
		</div>
		<div class="flex flex-col gap-2">
			for _, card := range col.Cards {
				@BoardCard(card)
			}
			if col.Lane.Slug == "human-review" {
				<div class="pt-1 text-center font-mono text-2xs leading-relaxed text-dim">
					the detent —<br/>released only by you
				</div>
			}
			if col.Overflow != "" {
				<div class="pt-1 text-center font-mono text-2xs text-dim">{ col.Overflow }</div>
			}
		</div>
	</div>
}

// BoardCard is one work item. The held card carries the warn ring — that is
// the catch, and it is the only element on the page that repeats an animation
// other than the live dot.
templ BoardCard(card content.Card) {
	<article
		class={ "rounded-card border bg-surface p-2.5",
			templ.KV("border-warn/40 dt-held", card.Held),
			templ.KV("border-line", !card.Held) }
	>
		<div class="flex items-baseline gap-1.5 font-mono text-2xs text-dim">
			<span class="text-sec">{ card.Ref }</span>
			<span class="truncate">{ card.Repo }</span>
		</div>
		<p class="mt-1 text-xs leading-snug text-text">{ card.Title }</p>
		if card.Status != "" {
			<div class={ "mt-1.5 flex items-start gap-1.5 font-mono text-2xs", ToneText(card.Tone) }>
				<span class="mt-1 shrink-0">
					@StatusDot(card.Tone, card.Tone == "ok" && !card.Held)
				</span>
				// Wraps on narrow lanes rather than truncating — a status the
				// reader cannot finish reading is worse than one on two lines.
				<span class="min-w-0 break-words xl:truncate">{ card.Status }</span>
			</div>
		}
	</article>
}

// LaneRail draws Detent's production delivery path with the gates marked
// between them. A gate is a catch, so it is drawn as one: a notch, not an
// arrow.
templ LaneRail() {
	<div class="overflow-x-auto rounded-card border border-line bg-page p-5">
		<div class="grid min-w-max grid-cols-[max-content_2rem_max-content_2rem_max-content_2rem_max-content_2rem_max-content] items-center font-mono text-xs">
			<div class="contents" data-lane-rail-path="forward">
				for _, lane := range content.Lanes {
					if lane.Slug != "rework" {
						if lane.Slug != "todo" {
							@railJoin(hasGate(lane.Slug))
						}
						@railLane(lane)
					}
				}
			</div>
			<div
				class="col-start-3 col-end-6 row-start-2 flex items-center pt-2 text-dim"
				data-lane-rail-path="return"
				role="img"
				aria-label="Human Review returns through Rework to In Progress"
			>
				<span class="grow whitespace-nowrap text-right" aria-hidden="true">&#8624;&#8212;&#8212;&#8212;&#8212;</span>
				for _, lane := range content.Lanes {
					if lane.Slug == "rework" {
						@railLane(lane)
					}
				}
				<span class="grow whitespace-nowrap" aria-hidden="true">&#9666;&#8212;&#8212;&#8212;&#8212;&#9496;</span>
			</div>
		</div>
		<p class="mt-4 font-mono text-2xs leading-relaxed text-dim">
			The notch marks a gate you defined. Lanes are workflow-defined: this is the delivery path.
			Detent&#39;s own board also configures Backlog, Blocked, and Cancelled.
		</p>
	</div>
}

templ railLane(lane content.Lane) {
	<span
		class={ "whitespace-nowrap rounded-chip border px-3 py-1.5",
			templ.KV("border-ok/40 text-ok", lane.Slug == "done"),
			templ.KV("border-line bg-elev text-text", lane.Slug != "done") }
	>
		{ lane.Name }
	</span>
}

templ railJoin(gate bool) {
	if gate {
		<span class="px-1.5 text-warn" title="a gate you defined">&#8212;&#9666;&#8212;</span>
	} else {
		<span class="px-2 text-dim">&#8212;&#8212;</span>
	}
}

// hasGate reports whether a gate guards entry to the lane.
func hasGate(slug string) bool {
	return slug == "human-review" || slug == "merging" || slug == "done"
}
